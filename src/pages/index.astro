---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const years = [...new Set(posts.map((post) => post.data.date.getFullYear()))];
const categories = [...new Set(posts.map((post) => post.data.category))];
const shortDate = (date: Date) => date.toISOString().slice(5, 10);
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<BaseLayout>
  <main class="home-layout">
    <section class="archive" aria-label="文章列表">
      {
        years.map((year) => (
          <section class="year-group" aria-labelledby={`year-${year}`}>
            <h2 class="year" id={`year-${year}`}>{year}</h2>
            <ol class="posts">
              {posts
                .filter((post) => post.data.date.getFullYear() === year)
                .map((post) => (
                  <li class="post" data-category={post.data.category}>
                    <time class="date" datetime={post.data.date.toISOString()}>
                      {shortDate(post.data.date)}
                    </time>
                    <span class="post-title">
                      <a href={`${base}posts/${post.id}/`}>{post.data.title}</a>
                    </span>
                  </li>
                ))}
            </ol>
          </section>
        ))
      }
    </section>

    <aside class="profile" aria-label="个人信息">
      <a class="avatar" href={base} aria-label="首页，显示全部文章">川</a>
      <p class="bio">写技术、生活和偶然冒出的念头。只留下经过思考的文字。</p>

      <nav class="social-links" aria-label="社交媒体">
        <a href="https://github.com/yourname" aria-label="GitHub">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.52-1.34-1.28-1.7-1.28-1.7-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.57-.29-5.27-1.28-5.27-5.68 0-1.26.45-2.28 1.19-3.09-.12-.29-.52-1.47.11-3.05 0 0 .97-.31 3.16 1.18a10.9 10.9 0 0 1 5.76 0c2.2-1.49 3.16-1.18 3.16-1.18.63 1.58.23 2.76.11 3.05.74.81 1.19 1.83 1.19 3.09 0 4.41-2.71 5.38-5.29 5.67.42.36.79 1.07.79 2.16v3.2c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" /></svg>
        </a>
        <a href="https://x.com/yourname" aria-label="X">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18.9 2H22l-6.77 7.74L23.2 22h-6.24l-4.89-6.39L6.48 22H3.36l7.26-8.3L2.97 2h6.4l4.42 5.84L18.9 2Zm-1.1 17.84h1.72L8.43 4.05H6.58L17.8 19.84Z" /></svg>
        </a>
        <a href="mailto:hello@example.com" aria-label="电子邮件">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 4h18a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2Zm9 9L3.5 6.5v11h17v-11L12 13Zm0-2.5L20.5 6h-17l8.5 4.5Z" /></svg>
        </a>
        <a href={`${base}rss.xml`} aria-label="RSS">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 3a2 2 0 1 0 0 4c6.63 0 12 5.37 12 12a2 2 0 1 0 4 0C21 10.16 13.84 3 5 3Zm0 7a2 2 0 1 0 0 4 5 5 0 0 1 5 5 2 2 0 1 0 4 0c0-4.97-4.03-9-9-9Zm0 7a2 2 0 1 0 0 4 2 2 0 0 0 0-4Z" /></svg>
        </a>
      </nav>

      <nav class="categories" aria-label="文章分类">
        <ul>
          {categories.map((category) => (
            <li><a href={`#${category}`} data-filter={category}>{category}</a></li>
          ))}
        </ul>
      </nav>
      <p class="sr-only" id="filter-status" aria-live="polite"></p>
    </aside>
  </main>

  <script>
    const filterLinks = document.querySelectorAll<HTMLAnchorElement>("[data-filter]");
    const posts = document.querySelectorAll<HTMLElement>(".post[data-category]");
    const yearGroups = document.querySelectorAll<HTMLElement>(".year-group");
    const filterStatus = document.querySelector<HTMLElement>("#filter-status");

    function showCategory(selected: string) {
      let visibleCount = 0;

      posts.forEach((post) => {
        const matches = post.dataset.category === selected;
        post.hidden = !matches;
        if (matches) visibleCount += 1;
      });

      yearGroups.forEach((group) => {
        group.hidden = !group.querySelector(".post:not([hidden])");
      });

      filterLinks.forEach((link) => {
        link.toggleAttribute("aria-current", link.dataset.filter === selected);
      });

      if (filterStatus) filterStatus.textContent = `${selected}：${visibleCount} 篇文章`;
    }

    filterLinks.forEach((link) => {
      link.addEventListener("click", () => showCategory(link.dataset.filter ?? ""));
    });

    const initialFilter = decodeURIComponent(location.hash.slice(1));
    if ([...filterLinks].some((link) => link.dataset.filter === initialFilter)) {
      showCategory(initialFilter);
    }
  </script>
</BaseLayout>
