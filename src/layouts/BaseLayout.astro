---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "山川与字句",
  description = "写技术、生活和偶然冒出的念头。",
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      const savedTheme = localStorage.getItem("theme");
      const systemTheme = matchMedia("(prefers-color-scheme: dark)").matches
        ? "dark"
        : "light";
      document.documentElement.dataset.theme = savedTheme || systemTheme;
    </script>
  </head>
  <body>
    <slot />

    <footer class="page-footer">
      由 <a href="https://astro.build/">Astro</a> 驱动 · 主题
      <a href="https://github.com/chalmery/astro-theme-sumi">sumi</a>
    </footer>

    <div class="floating-actions" aria-label="页面工具">
      <button id="theme-toggle" type="button" aria-label="切换深浅色模式">
        <span aria-hidden="true">◐</span>
      </button>
      <button id="back-to-top" type="button" aria-label="回到顶部">
        <span aria-hidden="true">↑</span>
      </button>
    </div>

    <script>
      const root = document.documentElement;
      const themeToggle = document.querySelector<HTMLButtonElement>("#theme-toggle");
      const backToTop = document.querySelector<HTMLButtonElement>("#back-to-top");

      themeToggle?.addEventListener("click", () => {
        const nextTheme = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = nextTheme;
        localStorage.setItem("theme", nextTheme);
        window.dispatchEvent(new CustomEvent("theme-change", { detail: nextTheme }));
      });

      backToTop?.addEventListener("click", () => {
        window.scrollTo({ top: 0, behavior: "smooth" });
      });
    </script>
  </body>
</html>
